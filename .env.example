# Copie este arquivo para .env e preencha somente o que for usar.
# O .env é ignorado pelo Git; nunca coloque chaves reais neste arquivo de exemplo.

# Opcional: sem a chave, todo o processamento fica local (Ollama)
GEMINI_API_KEY=

# Claude para programação e análise de ideias. Sem ele, a reserva local responde.
# assinatura = Claude Code instalado e logado no seu plano (comando `claude -p`, sem cobrança extra)
# api = ANTHROPIC_API_KEY abaixo (cobrada à parte)
CLAUDE_MODO=assinatura
CLAUDE_MODELO_ASSINATURA=sonnet
# Limite do plano atingido: tenta de novo depois destes minutos
CLAUDE_ASSINATURA_RETESTE_MIN=60

# Modo api: chave do Console da Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-sonnet-5-5
# Teto de gasto do assistente no mês, em US$ (defina também um limite no Console da Anthropic)
CLAUDE_LIMITE_MENSAL_USD=5
# Preço por milhão de tokens do modelo acima (entrada/saída), para estimar o gasto
CLAUDE_PRECO_ENTRADA=2
CLAUDE_PRECO_SAIDA=10
# Sem cota, o Claude volta a ser testado na primeira solicitação depois desta hora
CLAUDE_HORA_RETESTE=8

# Modelos e tempos do Ollama (endereço do servidor: OLLAMA_HOST, padrão http://127.0.0.1:11434)
OLLAMA_MODELO_PADRAO=gemma4:e4b
OLLAMA_MODELO_AVANCADO=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
# Repetição quando o modelo devolve resposta malformada
RETRY_TENTATIVAS=3
RETRY_ESPERA_S=3

# Notas fiscais: pasta vigiada e onde os originais ficam guardados (padrão: ao lado do projeto)
ENTRADAS_DIR=
ANEXOS_DIR=
# Modelo local que lê fotos de cupom (precisa entender imagem)
OLLAMA_MODELO_VISAO=qwen2.5vl:7b

# Python usado pelo Electron (vazio = .venv do projeto, se existir; senão python/python3)
ASSISTENTE_PYTHON=

# Saída dos modelos locais restrita por JSON Schema (1 = ligada, 0 = JSON simples)
OLLAMA_SAIDA_ESTRUTURADA=1
# Raciocínio dos modelos locais: vazio = padrão do Ollama, 0 = desliga, 1 = liga
OLLAMA_RACIOCINIO=

# Embeddings locais (CPU)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# cpu (padrão) ou cuda
EMBEDDING_DEVICE=cpu

# Skill ProjectAnalyzer
PROJECT_ANALYZER_OUTPUT_DIR=
PROJECT_ANALYZER_MODEL=qwen2.5-coder:7b

# Registro de eventos (Logs/eventos-AAAA-MM-DD.jsonl)
# 0 = não grava o texto das mensagens do usuário, só o tamanho
LOG_CONTEUDO=1
LOG_RETENCAO_DIAS=30

# Cópia de segurança automática (core/database/backups/auto)
BACKUP_ATIVO=1
BACKUP_DIARIOS=7
BACKUP_SEMANAIS=4

# Áudio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
AUDIO_RECORD_SECONDS=20

# Opcional: bot do Telegram para mandar ideias do celular (crie com o @BotFather)
TELEGRAM_BOT_TOKEN=
# Seu chat (número). Descubra com configurar-telegram.bat. Vários: separe por vírgula
TELEGRAM_CHAT_IDS=

# M20: histórico da conversa (fica só no SQLite local)
HISTORICO_JANELA_TROCAS=6
HISTORICO_RETOMAR_HORAS=12
HISTORICO_RESUMO=1
